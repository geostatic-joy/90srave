{
  "name": "90srave",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser-based 90-second audio snippet tool with an optional record-scratch ending.",
  "scripts": {
    "dev": "npm run prep && vite",
    "build": "npm run prep && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "prep": "npm run vendor:flac && npm run sfx:index",
    "vendor:flac": "node scripts/vendor-flac.mjs",
    "sfx:index": "node scripts/build-sfx-index.mjs",
    "postinstall": "npm run prep",
    "test:browser": "node tests/browser.mjs"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "libflacjs": "^5.6.0",
    "wavesurfer.js": "^7.12.12"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vite": "^7.1.0"
  }
}
